msgstr "Overovací token musí mať aspoň 4 znaky."

msgid "Verify your email address before creating your organization profile."
msgstr "Pred vytvorením profilu organizácie overte svoju e-mailovú adresu."

msgid "View Invites"
msgstr "Zobraziť pozvánky"

msgid "Website"
msgstr "Webová stránka"

msgid "Welcome back to NTI"
msgstr "Vitajte späť v NTI"

msgid "What are your main areas of interest?"
msgstr "Aké sú vaše hlavné oblasti záujmu?"

msgid "What kind of team role are you looking for?"
msgstr "Akú rolu v tíme hľadáte?"

msgid "Year cannot be in the past."
msgstr "Rok nemôže byť v minulosti."

msgid "Year is too far in the future."
msgstr "Rok je príliš vzdialený v budúcnosti."

msgid "Year of study must be a whole number."
msgstr "Ročník štúdia musí byť celé číslo."

msgid "Year of study must be between 1 and 8."
msgstr "Ročník štúdia musí byť medzi 1 a 8."

msgid "Yes"
msgstr "Áno"

msgid "You already joined the invited team. Finish the academic and professional sections to unlock the main app."
msgstr "Už ste sa pripojili k pozvanému tímu. Vyplňte sekcie týkajúce sa vzdelania a profesijnej praxe, aby ste odomkli hlavnú aplikáciu."

msgid "You can enter the domain only. HTTPS will be added automatically if needed."
msgstr "Môžete zadať iba doménu. HTTPS bude v prípade potreby pridané automaticky."

msgid "You can request another email after the countdown finishes."
msgstr "O ďalší e-mail môžete požiadať po dokončení odpočítavania."

msgid "You must accept the academic declaration."
msgstr "Musíte prijať akademické vyhlásenie."

msgid "You must accept the terms."
msgstr "Musíte prijať podmienky."

msgid "You survived the boss fight"
msgstr "Prežili ste boss fight"

msgid "Your admin session has expired."
msgstr "Vaša administrátorská relácia vypršala."

msgid "your email address"
msgstr "vaša e-mailová adresa"

msgid "Your Role (e.g., Frontend Dev)"
msgstr "Vaša rola (napr. Frontend Dev)"

msgid "Your Top 3 Soft Skills"
msgstr "Vaše 3 najsilnejšie mäkké zručnosti"
